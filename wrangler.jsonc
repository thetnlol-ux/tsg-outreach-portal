{
  "name": "tsg-outreach-portal",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",

  // Everything the router (src/index.js) doesn't recognise as an API route
  // falls through to whatever's in /public - just index.html for now.
  // run_worker_first is required here: without it Cloudflare serves a
  // matching static asset (index.html, on almost every request) straight
  // from the asset store and never invokes the Worker at all - which
  // means the session check in src/auth.js would never run.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsg-outreach-portal-db",
      "database_id": "cd433f1c-967a-4267-ada5-d20452858419"
    }
  ],

  // Requires outreach.tsgroup.cloud to already be on this Cloudflare
  // account's tsgroup.cloud zone (it is - same zone tsg-portal uses).
  "routes": [
    { "pattern": "outreach.tsgroup.cloud", "custom_domain": true }
  ],

  // Background Lead Forensics sync (src/shared/leadForensics.js) - every
  // 6 hours is comfortably inside their 1000-calls/day limit (a full sync
  // is ~6 GetAllBusinesses calls plus one GetVisitsByBusiness/
  // GetPagesByVisit pair per genuine domain match, which real-world usage
  // suggests is a small number).
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  // Not sensitive - safe to keep here in the repo, same as tsg-portal.
  // MS_PRIVATE_KEY_PKCS8, SESSION_SECRET, the two
  // SALESFORCE_CLIENT_SECRET_* values and LEADFORENSICS_API_KEY are added
  // as encrypted secrets via the Cloudflare dashboard instead, never
  // committed to the repo.
  "vars": {
    "MS_CLIENT_ID": "b4d0b124-c075-4387-9e07-4c0d1bf9a4d2",
    "MS_REDIRECT_URI": "https://outreach.tsgroup.cloud/auth/callback",
    "MS_OUTLOOK_REDIRECT_URI": "https://outreach.tsgroup.cloud/connect/outlook/callback",
    "MS_CERT_THUMBPRINT": "2BCD9F147AA79DDE506190FE7F7E2103054328BF",
    "ALLOWED_EMAIL_DOMAINS": "tapflopumps.co.uk,sychem.co.uk",
    "ADMIN_EMAILS": "steve.smith@tapflopumps.co.uk",
    "ZOOMINFO_CLIENT_ID": "0oa17n6sjtuKIlRLo698",
    "LEADFORENSICS_CLIENT_ID": "216527",

    // Sychem isn't wired up yet (licensing) - only Tapflo's vars are set,
    // so resolveSalesforceOrg() cleanly reports "not set up yet" for a
    // Sychem user rather than a Connected App that doesn't really exist.
    "SALESFORCE_REDIRECT_URI": "https://outreach.tsgroup.cloud/connect/salesforce/callback",
    "SALESFORCE_DOMAIN_TAPFLO": "tapflouk.my.salesforce.com",
    "SALESFORCE_CLIENT_ID_TAPFLO": "3MVG9sh10GGnD4Dtof_piPO7oYvc1VuielIB9Rh7uTCVK7fPB1pE0JHQ0vMYnFsgG4KeL.SI7x.8WAmfO7Rsk"
  }
}
